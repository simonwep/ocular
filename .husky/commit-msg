message="$(cat $1)"
regex="^(fix|feat|chore|refactor|test)(\((ocular|genesis|docs)\))?: [a-z].*$"

if ! [[ $message =~ $regex ]]; then
  echo "Commit message does not follow Conventional Commits format: <type>(<scope>): <lowercase message>"
  echo "Allowed types: fix, feat, chore, refactor, test; scopes: ocular, genesis, docs"
  echo "Got message: '$message'"
  exit 1
fi

