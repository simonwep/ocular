{
  "name": "ocular",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Simon Reinisch <contact@reinisch.io>",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.12.0"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:.+/\"",
    "dev:frontend": "vite --host",
    "dev:backend": "go -C genesis run . start",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"**/*.{js,mjs,ts,mts,vue,json}\" --cache",
    "lint:fix": "pnpm lint --fix",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm \"/^(lint:fix|build|test:unit|test:e2e)$/\"",
    "docs:dev": "vitepress dev docs --host",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "scripts:currencies": "tsx scripts/currencies/update.ts",
    "scripts:screenshots": "tsx scripts/screenshots/generate.ts",
    "scripts:localize": "tsx scripts/localizer/main.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@remixicon/vue": "4.9.0",
    "@vueuse/core": "14.4.0",
    "echarts": "6.1.0",
    "papaparse": "5.7.0",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.1",
    "yuppee": "1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@github/copilot-sdk": "1.0.11",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@playwright/test": "1.62.1",
    "@types/ackee-tracker": "5.0.4",
    "@types/html-minifier-terser": "7.0.2",
    "@types/node": "26.4.1",
    "@types/papaparse": "5.5.2",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prefer-arrow-functions": "3.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.10.0",
    "fast-xml-parser": "5.11.1",
    "html-minifier-terser": "7.2.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "sass": "1.104.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vite-plugin-optimize-css-modules": "1.4.0",
    "vite-plugin-pwa": "1.3.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitepress": "1.6.4",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
